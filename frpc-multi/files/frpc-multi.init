#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

NAME=frpc-multi
PROG=/usr/bin/frpc-multi
CONFIG_DIR=/etc/frp/frpc.d

start_instance() {
	local section="$1"
	local enabled name config_file

	config_get_bool enabled "$section" enabled 0
	[ "$enabled" -eq 1 ] || return 0

	config_get name "$section" name
	case "$name" in
		''|[-_]*|*[!A-Za-z0-9_-]*)
			logger -t "$NAME" "Ignoring invalid instance name: $name"
			return 0
		;;
	esac

	[ "${#name}" -le 64 ] || {
		logger -t "$NAME" "Ignoring instance name longer than 64 characters: $name"
		return 0
	}

	config_file="$CONFIG_DIR/$name.toml"
	[ -r "$config_file" ] || {
		logger -t "$NAME" "Ignoring $name: $config_file is not readable"
		return 0
	}

	procd_open_instance "$name"
	procd_set_param command "$PROG" -c "$config_file"
	procd_set_param file "$config_file"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn
	procd_close_instance
}

start_service() {
	config_load "$NAME"
	config_foreach start_instance instance
}

service_triggers() {
	procd_add_reload_trigger "$NAME"
}

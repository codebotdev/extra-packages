[submodule "OpenClash"]
	path = OpenClash
	url = https://github.com/vernesong/OpenClash.git
	branch = master
	shallow = true
	fetchRecurseSubmodules = true
[submodule "rtp2httpd"]
	path = rtp2httpd
	url = https://github.com/stackia/rtp2httpd.git
	branch = main
	shallow = true
	fetchRecurseSubmodules = true
[submodule "tproxy-lan"]
	path = tproxy-lan
	url = https://github.com/codebotdev/tproxy-lan.git
	branch = main
	shallow = true
	fetchRecurseSubmodules = true

msgid "Add instance"
msgstr "添加实例"

msgid "Config"
msgstr "配置"

msgid "Unable to read configuration file:"
msgstr "无法读取配置文件："

msgid "The target configuration file already exists:"
msgstr "目标配置文件已存在，请使用其他名称："

msgid "Changes cannot be undone after saving."
msgstr "保存后无法恢复。"

msgid "Configuration must not be empty."
msgstr "配置不能为空。"

msgid "Configuration validation failed:"
msgstr "配置校验失败："

msgid "Unknown error"
msgstr "未知错误"

msgid "Configuration file path: /etc/frp/frpc.d/<name>.toml"
msgstr "配置文件路径：/etc/frp/frpc.d/<名称>.toml"

msgid "If other files are needed, please add them manually."
msgstr "如果需要其他文件请手动添加。"

msgid "Disabled"
msgstr "已禁用"

msgid "Enabled"
msgstr "启用"

msgid "FRP Client"
msgstr "FRP 客户端"

msgid "Instances"
msgstr "实例"

msgid "Invalid instance name"
msgstr "实例名称无效"

msgid "Name"
msgstr "名称"

msgid "Run multiple independent frpc processes using TOML files in %s. frpc version: %s"
msgstr "使用 %s 中的 TOML 文件运行多个独立的 frpc 进程。frpc 版本：%s"

msgid "Running"
msgstr "运行中"

msgid "Status"
msgstr "状态"

msgid "Stopped"
msgstr "已停止"

msgid "The instance name must be unique."
msgstr "实例名称不能重复。"

msgid "Use 1-64 letters, numbers, underscores or hyphens, starting with a letter or number."
msgstr "请输入 1 至 64 个字符，只能包含字母、数字、下划线或连字符，并以字母或数字开头。"
